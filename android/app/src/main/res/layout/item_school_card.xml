<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="7dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/colorCardBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Logo Frame -->
            <ImageView
                android:id="@+id/imgSchoolLogo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_pill_chip"
                android:padding="6dp"
                android:src="@drawable/ic_logo"
                android:contentDescription="شعار المدرسة" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvSchoolName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مدارس النخبة النموذجية"
                        android:textColor="@color/colorTextHeading"
                        android:textSize="14.5sp"
                        android:fontFamily="@font/cairo"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBadgeSchoplus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge_gold"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="1.5dp"
                        android:paddingBottom="1.5dp"
                        android:text="⚡ SchoPlus"
                        android:textColor="#B45309"
                        android:textSize="10.5sp"
                        android:fontFamily="@font/cairo"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الخرطوم — بحري"
                        android:textColor="@color/colorTextBody"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/cairo" />

                    <TextView
                        android:id="@+id/tvEstablished"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="• تأسست: 2012"
                        android:textColor="@color/colorGreen"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/cairo"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <!-- Rating Badge -->
            <LinearLayout
                android:id="@+id/layoutRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pill_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_nav_star"
                    app:tint="@color/colorGold"
                    android:contentDescription="تقييم" />

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="4.9"
                    android:textColor="@color/colorTextHeading"
                    android:textSize="12sp"
                    android:fontFamily="@font/cairo"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Description preview -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="مؤسسة تعليمية نموذجية تقدم تعليماً متطوراً وشاملاً..."
            android:textColor="@color/colorTextBody"
            android:textSize="12sp"
            android:fontFamily="@font/cairo"
            android:lineSpacingExtra="2dp" />

        <!-- Bottom Action Bar (Divider & Actions) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/colorBorder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTypeTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_chip"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="مدرسة خاصة"
                android:textColor="@color/colorBlue"
                android:textSize="11.5sp"
                android:fontFamily="@font/cairo"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- WhatsApp Action Button -->
            <LinearLayout
                android:id="@+id/btnSchoolWhatsapp"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_chip"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_dialog_email"
                    app:tint="#25D366"
                    android:contentDescription="واتساب" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="واتساب"
                    android:textColor="#16A34A"
                    android:textSize="11sp"
                    android:fontFamily="@font/cairo"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Call Action Button -->
            <LinearLayout
                android:id="@+id/btnSchoolCall"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_chip"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@android:drawable/ic_menu_call"
                    app:tint="@color/colorBlue"
                    android:contentDescription="اتصال" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="اتصال"
                    android:textColor="@color/colorBlue"
                    android:textSize="11sp"
                    android:fontFamily="@font/cairo"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
