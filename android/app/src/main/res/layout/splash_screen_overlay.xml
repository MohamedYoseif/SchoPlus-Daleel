<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B2A52"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="260dp"
            android:layout_height="110dp"
            android:src="@drawable/logo_daleel_full"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter" />

        <ProgressBar
            android:id="@+id/splash_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="4dp"
            android:layout_marginTop="28dp"
            android:indeterminate="true"
            android:indeterminateTint="#F5A020"
            android:progressTint="#F5A020" />

        <TextView
            android:id="@+id/splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="دليل المدارس السودانية المعتمدة"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/cairo"
            android:textStyle="bold"
            android:alpha="0" />

        <TextView
            android:id="@+id/splash_subtag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="المنصة الوطنية الموحدة — مدعوم بمنظومة SchoPlus"
            android:textColor="#93C5FD"
            android:textSize="11sp"
            android:fontFamily="@font/cairo"
            android:alpha="0" />

    </LinearLayout>

</RelativeLayout>
