# SchoPlus Schools Directory (.htaccess)
Options -Indexes +FollowSymLinks
RewriteEngine On

# Increase PHP upload limits where supported
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
</IfModule>

# Rewrite any relative /school/uploads/... or /s/uploads/... requests to root /uploads/...
RewriteRule ^(?:school|s)/uploads/(.*)$ /uploads/$1 [L,NC]
RewriteRule ^(?:school|s)/assets/(.*)$ /assets/$1 [L,NC]

# Allow direct access to real files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redirect any accidental school/index or school/index.php to root
RewriteRule ^school/index(\.php)?/?$ / [R=301,L]

# 1. Ultra-Short Profile Link by numeric ID: /s/12 -> school.php?id=12
RewriteRule ^s/([0-9]+)/?$ school.php?id=$1 [L,QSA]

# 2. Short Profile Link by slug: /s/{slug} -> school.php?slug=$1
RewriteRule ^s/([^/]+)/?$ school.php?slug=$1 [L,QSA]

# 3. Vanity Handle URL: /@{slug} -> school.php?slug=$1
RewriteRule ^@([^/]+)/?$ school.php?slug=$1 [L,QSA]

# 4. Standard Clean SEO URL: /school/{slug} -> school.php?slug=$1
RewriteCond %{REQUEST_URI} !index(\.php)?$ [NC]
RewriteRule ^school/([^/]+)/?$ school.php?slug=$1 [L,QSA]

# 5. Clean URLs for existing .php files (e.g. /login -> login.php, /dashboard -> dashboard.php)
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([a-zA-Z0-9\-_]+)/?$ $1.php [L,QSA]

# 6. Direct root vanity slug (if not matching any file, folder, or PHP page)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php !-f
RewriteCond $1 !^(index|login|register|dashboard|logout|schools|api)$ [NC]
RewriteRule ^([^/]+)/?$ school.php?slug=$1 [L,QSA]
